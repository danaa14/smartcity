# OpenCode Go API key (Settings → API keys at https://opencode.ai). Muse Spark requires
# "Allow paid endpoints that train on request data" in the workspace Privacy settings.
OPENCODE_API_KEY=your-opencode-api-key
AI_MODEL=muse-spark-1.3-contributor
# AI_MODE=off            # force the deterministic demo mode
# AI_TIMEOUT_MS=90000
OPENAI_API_KEY=your-openai-api-key
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Google OAuth only. Server-side values: never prefix with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3100
